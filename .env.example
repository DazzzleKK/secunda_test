# Copy to .env and adjust. Never commit the real .env file.

# --- Application -----------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# Static API key expected in the X-API-Key header of every HTTP endpoint.
# The same value is the default of docker-compose.yml, so `docker compose up`
# works both with and without a copied .env file.
API_KEY=local-dev-api-key

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# --- Outbox relay ----------------------------------------------------------
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=1000

# --- Payment gateway emulator ---------------------------------------------
GATEWAY_SUCCESS_RATE=0.9
GATEWAY_MIN_DELAY_MS=2000
GATEWAY_MAX_DELAY_MS=5000
GATEWAY_RANDOM_SEED=42

# --- Messaging retries -----------------------------------------------------
# One value per retry, so N values mean N retries and N+1 processings in total;
# after the last one the message goes to payments.dlq. For the demo use 1000,2000.
RETRY_DELAYS_MS=5000,25000

# --- Webhooks --------------------------------------------------------------
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_SIGNING_SECRET=local-dev-signing-secret
